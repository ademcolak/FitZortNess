{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitzortness.local/knowledge/schema.json",
  "title": "FitZortNess Knowledge Document",
  "type": "object",
  "required": ["schema_version", "kind", "items"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "enum": ["sources", "claims", "splits", "sports"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "type": "string", "minLength": 3 } },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "claims" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": ["id", "topics", "statement_tr", "limitations_tr", "evidence_level", "source_ids"],
              "properties": {
                "topics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "statement_tr": { "type": "string", "minLength": 1 },
                "limitations_tr": { "type": "string", "minLength": 1 },
                "evidence_level": { "type": "string", "minLength": 1 },
                "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "sources" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": ["id", "title", "organization_or_journal", "year", "url", "evidence_type", "source_scope", "license", "reviewed_at"],
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "organization_or_journal": { "type": "string", "minLength": 1 },
                "year": { "type": "integer", "minimum": 1900 },
                "url": { "type": "string", "pattern": "^https://" },
                "evidence_type": { "type": "string", "minLength": 1 },
                "source_scope": { "enum": ["evidence", "consensus", "brand_definition", "governing_body_definition", "competition_rules", "safety_authority", "anti_doping_authority"] },
                "license": { "type": "string", "minLength": 1 },
                "reviewed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "version": { "type": "string", "minLength": 1 },
                "effective_from": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "jurisdiction": { "type": "string", "minLength": 1 },
                "checked_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "refresh_after": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
              },
              "allOf": [
                {
                  "if": { "properties": { "evidence_type": { "pattern": "^living_" } }, "required": ["evidence_type"] },
                  "then": { "required": ["version", "effective_from", "jurisdiction", "checked_at", "refresh_after"] }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "sports" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": ["id", "kind", "canonical_name", "aliases", "classification", "definition_tr", "family_tags", "inference_policy", "claim_ids", "authority_source_ids"],
              "properties": {
                "kind": { "const": "sport_profile" },
                "canonical_name": { "type": "string", "minLength": 1 },
                "aliases": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "classification": { "type": "string", "minLength": 1 },
                "definition_tr": { "type": "string", "minLength": 1 },
                "family_tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "inference_policy": {
                  "type": "object",
                  "required": ["name_alone_is_sufficient", "required_user_fields"],
                  "properties": {
                    "name_alone_is_sufficient": { "type": "boolean" },
                    "required_user_fields": { "type": "array", "items": { "type": "string" } }
                  },
                  "additionalProperties": false
                },
                "claim_ids": { "type": "array", "items": { "type": "string" } },
                "authority_source_ids": { "type": "array", "items": { "type": "string" } },
                "authority_bindings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["aliases", "source_ids"],
                    "properties": {
                      "aliases": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                      "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                    },
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "splits" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": ["id", "kind", "canonical_name", "aliases", "classification", "definition_tr", "inference_policy", "claim_ids"],
              "properties": {
                "kind": { "enum": ["split_pattern", "named_program", "training_method", "workout_format", "workout_variant", "sport_policy"] },
                "canonical_name": { "type": "string", "minLength": 1 },
                "aliases": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "classification": { "type": "string", "minLength": 1 },
                "definition_tr": { "type": "string", "minLength": 1 },
                "inference_policy": {
                  "type": "object",
                  "required": ["name_alone_is_sufficient", "required_user_fields"],
                  "properties": {
                    "name_alone_is_sufficient": { "type": "boolean" },
                    "required_user_fields": { "type": "array", "items": { "type": "string" } }
                  },
                  "additionalProperties": false
                },
                "claim_ids": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
